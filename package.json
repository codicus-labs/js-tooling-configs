{
    "name": "js-tooling-configs",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @codicus/configs build",
        "check": "pnpm run '/^(typecheck|lint|format:check|unused)$/'",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "hooks:install": "git config core.hooksPath .githooks",
        "prepare": "pnpm run build",
        "typecheck": "tsc -p tsconfig.json",
        "unused": "knip"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.2",
        "@types/node": "26.1.0",
        "knip": "6.37.0",
        "lint-staged": "17.5.1",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "oxlint-tsgolint": "7.0.2002",
        "svelte": "5.57.1",
        "typescript": "6.0.3"
    },
    "lint-staged": {
        "*.{js,ts}": [
            "oxfmt",
            "oxlint --fix --no-error-on-unmatched-pattern"
        ],
        "*.{json,jsonc,md,mdx,yaml,yml,css,scss,svelte,html}": "oxfmt"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.4.2",
    "knip": {
        "ignore": [
            "packages/pnpm-plugin/pnpmfile.mjs"
        ],
        "ignoreDependencies": [
            "@commitlint/cli",
            "lint-staged"
        ]
    }
}
