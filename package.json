{
    "name": "@codicus/configs",
    "version": "0.3.0",
    "description": "Shared JavaScript, TypeScript, and Svelte tooling configurations",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codicus-labs/js-tooling-configs.git"
    },
    "files": [
        "dist",
        "tsconfig",
        "pnpmfile.mjs"
    ],
    "type": "module",
    "exports": {
        "./eslint-svelte": {
            "types": "./dist/eslint-svelte.d.mts",
            "default": "./dist/eslint-svelte.mjs"
        },
        "./oxlint": {
            "types": "./dist/oxlint.d.mts",
            "default": "./dist/oxlint.mjs"
        },
        "./lint-rules": {
            "types": "./dist/lint-rules/index.d.mts",
            "default": "./dist/lint-rules/index.mjs"
        },
        "./tsconfig/base.json": "./tsconfig/base.json",
        "./tsconfig/node.json": "./tsconfig/node.json",
        "./oxfmt": {
            "types": "./dist/oxfmt.d.mts",
            "default": "./dist/oxfmt.mjs"
        },
        "./pnpm-plugin": "./pnpmfile.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "check": "pnpm run '/^(typecheck|lint|format:check|unused)$/'",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "hooks:install": "git config core.hooksPath .githooks",
        "prepare": "pnpm run build",
        "typecheck": "tsc -p tsconfig.json",
        "unused": "knip"
    },
    "dependencies": {
        "@eslint/js": "10.0.1",
        "@tsconfig/node24": "24.0.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-svelte": "3.23.0",
        "globals": "17.11.0"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.2",
        "@oxlint/plugins": "1.79.0",
        "@types/node": "26.1.0",
        "eslint": "10.9.0",
        "knip": "6.37.0",
        "lint-staged": "17.5.1",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "oxlint-tsgolint": "7.0.2002",
        "svelte": "5.57.1",
        "tsdown": "0.23.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    },
    "peerDependencies": {
        "@types/node": ">=24 <27",
        "eslint": ">=10 <11",
        "oxfmt": ">=0.64 <1",
        "oxlint": ">=1.79 <2",
        "oxlint-tsgolint": ">=7 <8",
        "svelte": ">=5 <6",
        "typescript": ">=5.9 <8",
        "typescript-eslint": ">=8.67 <9"
    },
    "peerDependenciesMeta": {
        "@types/node": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "oxfmt": {
            "optional": true
        },
        "oxlint": {
            "optional": true
        },
        "oxlint-tsgolint": {
            "optional": true
        },
        "svelte": {
            "optional": true
        },
        "typescript": {
            "optional": true
        },
        "typescript-eslint": {
            "optional": true
        }
    },
    "lint-staged": {
        "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}": [
            "oxfmt",
            "oxlint --fix --no-error-on-unmatched-pattern"
        ],
        "*.{json,jsonc,md,mdx,yaml,yml,css,scss,svelte,html}": "oxfmt"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.4.2",
    "knip": {
        "ignoreDependencies": [
            "@commitlint/cli",
            "lint-staged"
        ]
    }
}
