        "tsdown": "0.23.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    },
    "peerDependencies": {
        "eslint": ">=10 <11",
        "svelte": ">=5 <6",
        "typescript": ">=5.9 <7",
