{
    "name": "@codicus/eslint-svelte",
    "version": "0.1.0",
    "description": "Shared ESLint configuration for Svelte projects",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codicus-labs/js-tooling-configs.git",
        "directory": "packages/eslint-svelte"
