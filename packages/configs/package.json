{
    "name": "@codicus/configs",
    "version": "0.7.0",
    "description": "Shared Oxlint, Oxfmt, and TypeScript configurations",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codicus-labs/js-tooling-configs.git",
        "directory": "packages/configs"
    },
    "files": [
        "dist",
        "tsconfig"
    ],
    "type": "module",
    "exports": {
        "./oxlint": {
            "types": "./dist/oxlint.d.mts",
            "default": "./dist/oxlint.mjs"
        },
        "./lint-rules": {
            "types": "./dist/lint-rules/index.d.mts",
            "default": "./dist/lint-rules/index.mjs"
        },
        "./tsconfig/base.json": "./tsconfig/base.json",
        "./tsconfig/node.json": "./tsconfig/node.json",
        "./oxfmt": {
            "types": "./dist/oxfmt.d.mts",
            "default": "./dist/oxfmt.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown"
    },
    "dependencies": {
        "@tsconfig/node24": "24.0.5"
    },
    "devDependencies": {
        "@oxlint/plugins": "1.79.0",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "tsdown": "0.23.0",
        "typescript": "6.0.3"
    },
    "peerDependencies": {
        "@types/node": ">=24 <27",
        "oxfmt": ">=0.64 <1",
        "oxlint": ">=1.79 <2",
        "oxlint-tsgolint": ">=7 <8",
        "typescript": ">=5.9 <8"
    },
    "peerDependenciesMeta": {
        "@types/node": {
            "optional": true
        },
        "oxfmt": {
            "optional": true
        },
        "oxlint": {
            "optional": true
        },
        "oxlint-tsgolint": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24"
    }
}
